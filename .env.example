# Base64-encoded 32-byte encryption key. Set a secret runtime value in hosted Sites.
PLACEMENT_GITHUB_VAULT_KEY=
# Optional server-side connection, restricted to an existing authenticated Site user ID.
PLACEMENT_GITHUB_SETUP_TOKEN=
PLACEMENT_GITHUB_SETUP_USER_ID=
# Existing Sites deployment uses ChatGPT identity. Use github for a standalone host.
PLACEMENT_AUTH_MODE=chatgpt
PLACEMENT_PUBLIC_ORIGIN=
PLACEMENT_GITHUB_CLIENT_ID=
PLACEMENT_GITHUB_CLIENT_SECRET=
