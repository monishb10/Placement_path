# Base64-encoded 32-byte encryption key for saving accepted solutions to GitHub.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PLACEMENT_GITHUB_VAULT_KEY=

# Authentication: Exclusively GitHub OAuth
PLACEMENT_AUTH_MODE=github
PLACEMENT_PUBLIC_ORIGIN=https://YOUR-WEBSITE-DOMAIN

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
PLACEMENT_GITHUB_CLIENT_ID=
PLACEMENT_GITHUB_CLIENT_SECRET=

